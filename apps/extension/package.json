{
  "name": "@chrome-ninja/extension",
  "displayName": "chrome ninja",
  "description": "chrome ninja - Chrome MV3 extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:build": "vite build --watch",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@chrome-ninja/hmr": "workspace:*",
    "@chrome-ninja/utils": "workspace:*",
    "@base-ui/react": "1.7.0",
    "@hookform/resolvers": "5.8.0",
    "@fontsource/roboto": "5.1.0",
    "clsx": "2.1.1",
    "jotai": "2.10.3",
    "normalize.css": "8.0.1",
    "preact": "10.29.8",
    "react-hook-form": "7.85.0",
    "react-router": "6.28.0",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "3.6.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.28",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.0.283",
    "@types/node": "20.16.0",
    "tailwindcss": "4.3.3",
    "vite": "5.4.11",
    "vite-plugin-pages": "0.32.3",
    "vite-plugin-svgr": "4.3.0"
  }
}
