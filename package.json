{
  "name": "chrome-ninja",
  "displayName": "chrome ninja",
  "description": "chrome ninja - a Chrome MV3 extension monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @chrome-ninja/extension dev",
    "build": "pnpm --filter @chrome-ninja/extension build",
    "preview": "pnpm --filter @chrome-ninja/extension preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "style": "prettier \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --write",
    "commit": "cz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/preact": "3.2.6",
    "@vitest/coverage-v8": "4.1.12",
    "@ianvs/prettier-plugin-sort-imports": "4.4.0",
    "commitizen": "4.3.1",
    "cz-conventional-changelog-zh-cn": "0.0.7",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "jsdom": "26.1.0",
    "preact": "10.29.8",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.9",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "6.4.3",
    "vitest": "4.1.12"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog-zh-cn"
    }
  }
}
