{
  "printWidth": 120,
  "useTabs": false,
  "tabWidth": 2,
  "semi": false,
  "trailingComma": "none",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "tailwindStylesheet": "./apps/extension/src/index.css",
  "overrides": [
    {
      "files": "apps/web/**",
      "options": {
        "tailwindStylesheet": "./apps/web/src/index.css"
      }
    }
  ],
  "tailwindFunctions": ["clsx", "cn"],
  "tailwindAttributes": ["className", "wrapClassName", "classList"],
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": [
    "<TYPES>",
    "<TYPES>^[.]",
    "^react$",
    "^~(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^@[^(mui)(/)]",
    "^@mui",
    "^@/",
    "^[./]"
  ]
}
